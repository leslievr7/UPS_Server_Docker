# Ingore the production docker-compose.yml file
docker-compose.yml

# Ignore the actual config files
config/power_manager.conf
config/upshub.conf

# Ignore custom rsyslog configuration files
rsyslog/custom.conf

# Ignore local log files
logs/

# Ignore local environment file
.env

# Ignore version information files (generated automatically)
app/version_info.json
version_info.json

*.bkp
*.svg
*.drawio
*.docx
*.odt
mods/*
.venv/
.vscode/
# .dockerignore
media/UPS_Server_Podcast.m4a

# Internal project documents (not for GitHub)
Documentation/PRD_v2.md

# Draft replies / community posts (not for GitHub)
docs/reddit-*.md
.claude/
# Sandbox runtime folder (dev/run_local.py)
dev/.sandbox/
# Alternative Basecoat style packs for the style sample page (copied from the npm package)
dev/.styles/
# The icon sprite is part of the app (the *.svg rule above is for diagrams)
!app/static/icons/lucide.svg
# Web login credentials and session secret (created on first run)
config/web_auth.json

# Safe-save side files (app/config_store.py)
config/power_manager.conf.bak
config/.power_manager.conf.lock
config/.power_manager.conf.*.tmp
